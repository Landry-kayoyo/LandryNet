# API server
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me

# Database — PostgreSQL only (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# POSTGRES_URL or NEON_DATABASE_URL are also accepted aliases.

# Contact email via SMTP (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-account@example.com
CONTACT_EMAIL=hello@example.com

# Frontend — public variables (exposed to the browser via Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SITE_URL=http://localhost:5173
VITE_CONTACT_EMAIL=hello@example.com
